{
  "name": "jk-interior-gbp-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Google Business Profile automation system for JK Interior",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "get-refresh-token": "node scripts/get-refresh-token.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "google-auth-library": "^11.1.0",
    "next": "^16.3.5",
    "openai": "^7.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
