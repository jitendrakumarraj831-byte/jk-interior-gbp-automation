# ---------------------------------------------------------------------------
# JK Interior — Google Business Profile Automation
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real credentials.
# ---------------------------------------------------------------------------

# --- Google OAuth 2.0 (required to connect Google Business Profile) ---------
# Created in Google Cloud Console → APIs & Services → Credentials
# → OAuth client ID → Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match EXACTLY one of the "Authorized redirect URIs" on the OAuth client.
# Local:      http://localhost:3000/api/auth/google/callback
# Production: https://<your-vercel-domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Long-lived refresh token for the Google account that manages the
# JK Interior Business Profile. Obtain it once with `npm run get-refresh-token`
# or by completing the in-app "Connect Google" flow.
# Treat this like a password. Server-side only.
GOOGLE_REFRESH_TOKEN=

# --- AI reply drafting: multi-provider router -------------------------------
# The router tries providers left to right and falls back automatically when one
# is rate limited, times out, errors, or has no key. Configure at least one.
# All keys are server-side only: none may appear in client code, a
# NEXT_PUBLIC_* variable, or a log.
AI_PROVIDER_ORDER=groq,gemini,openai

# Primary — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Fallback — https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY empty to skip Gemini entirely.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional third fallback — https://platform.openai.com/api-keys
# Leave OPENAI_API_KEY empty to skip OpenAI entirely.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Vercel Cron protection (required in production) ------------------------
# Random high-entropy string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Admin dashboard protection (REQUIRED in production) --------------------
# The dashboard password. Production refuses to serve the dashboard or any
# admin API without this — it does NOT fall back to unauthenticated access.
# Local development may run without it as a convenience.
ADMIN_PASSWORD=
# Signs the admin session cookie. Also required in production.
# Generate like CRON_SECRET.
SESSION_SECRET=

# --- Optional: durable storage (Upstash Redis REST) -------------------------
# Without these the app uses an in-memory store, which is wiped on every
# serverless cold start. Fine for previewing, not for real automation.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: business defaults -------------------------------------------
# Pin the Business Profile location the dashboard works with, e.g.
# locations/1234567890  (discoverable in the dashboard once connected)
GBP_LOCATION_NAME=
# Pin the account, e.g. accounts/1234567890
GBP_ACCOUNT_NAME=

# --- Automation safety switches --------------------------------------------
# Keep this false. When true, approved AI replies may be published by cron
# without a human pressing Approve. Off by default, by design.
AUTO_PUBLISH_REPLIES=false
